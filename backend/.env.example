# Backend API (NestJS) + worker. Sao chép thành backend/.env rồi điền giá trị thật. Không commit file .env.
PORT=4000
# Origin của web Next.js được phép gọi API (CORS), cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng trên server (worker lưu kết quả AI, ký URL audio). Không bao giờ đưa xuống trình duyệt.
SUPABASE_SECRET_KEY=

# Chuỗi kết nối Postgres trực tiếp của Supabase (Project Settings → Database → Session pooler) cho hàng đợi pg-boss.
DATABASE_URL=

# AI service nội bộ (FastAPI trong src/ai-service): Whisper + engine chấm local.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
WHISPER_MODEL=small
# Số job ASR/chấm chạy song song trong một worker (Whisper tốn CPU, nên để thấp).
WORKER_CONCURRENCY=1
