# Faster-Whisper: tiny / base / small / medium, hoặc repo CTranslate2 trên Hugging Face.
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 (CPU) | float16 hoặc int8_float16 (GPU)
WHISPER_COMPUTE_TYPE=int8
# Số lượt nhận dạng chạy song song (mỗi lượt giữ thêm một bản model trong RAM)
WHISPER_WORKERS=1
AI_SERVICE_TOKEN=replace-with-a-long-random-secret
# Engine chấm điểm local (không dùng API AI bên ngoài).
# Model embedding Sentence Transformers; ngưỡng mặc định đã hiệu chỉnh cho model này (app/assessment/config.py).
GRADER_EMBEDDING_MODEL=keepitreal/vietnamese-sbert
# cpu | cuda | mps
GRADER_DEVICE=cpu
# Ghi đè ngưỡng sau khi hiệu chỉnh lại bằng scripts/evaluate_grader.py (để trống = dùng mặc định của model)
GRADER_SIM_LOW=
GRADER_SIM_HIGH=
GRADER_SEMANTIC_WEIGHT=
